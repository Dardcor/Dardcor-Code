{
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "sonarlint.rules": {
    "css:S4662": {
      "level": "off"
    }
  },
  "json.schemas": [
    {
      "fileMatch": [
        "**/.build/**/package.json"
      ],
      "url": "http://json.schemastore.org/package"
    }
  ]
}
