{
  "name": "dardcor-bat",
  "displayName": "Batch",
  "description": "Batch language grammar for Dardcor Code",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "languages": [
      {
        "id": "batch",
        "aliases": [
          "Batch",
          "batch"
        ],
        "extensions": [
          "bat",
          "cmd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "batch",
        "scopeName": "source.batch",
        "path": "./syntaxes/batch.tmLanguage.json"
      }
    ]
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}