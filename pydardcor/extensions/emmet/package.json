{
  "name": "dardcor-emmet",
  "displayName": "Emmet",
  "description": "Emmet abbreviation expansion",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "commands": [
      {
        "command": "emmet.hello",
        "title": "Emmet: Show Info"
      }
    ],
    "configuration": {
      "title": "Emmet",
      "properties": {
        "emmet.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Emmet"
        }
      }
    }
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}