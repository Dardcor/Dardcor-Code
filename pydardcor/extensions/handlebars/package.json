{
  "name": "dardcor-handlebars",
  "displayName": "Handlebars",
  "description": "Handlebars language grammar for Dardcor Code",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "languages": [
      {
        "id": "handlebars",
        "aliases": [
          "Handlebars",
          "handlebars"
        ],
        "extensions": [
          "handlebars",
          "hbs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "handlebars",
        "scopeName": "source.handlebars",
        "path": "./syntaxes/handlebars.tmLanguage.json"
      }
    ]
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}