{
  "name": "dardcor-configuration-editing",
  "displayName": "Configuration Editing",
  "description": "Provides settings, keybindings, and snippet editing features",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "commands": [
      {
        "command": "configuration-editing.hello",
        "title": "Configuration Editing: Show Info"
      }
    ],
    "configuration": {
      "title": "Configuration Editing",
      "properties": {
        "configuration-editing.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Configuration Editing"
        }
      }
    }
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}