    "configuration": {
      "title": "Debug Server Ready",
      "properties": {
        "debug-server-ready.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Debug Server Ready"
        }
      }
    }
  },
  "categories": [
    "Programming Languages",
