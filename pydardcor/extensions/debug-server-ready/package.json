{
  "name": "dardcor-debug-server-ready",
  "displayName": "Debug Server Ready",
  "description": "Server ready detection for debugging",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "commands": [
      {
        "command": "debug-server-ready.hello",
        "title": "Debug Server Ready: Show Info"
      }
