{
  "name": "dardcor-grunt",
  "displayName": "Grunt",
  "description": "Grunt language grammar for Dardcor Code",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "languages": [
      {
        "id": "javascript",
        "aliases": [
          "Grunt",
          "javascript"
        ],
        "extensions": [
          "Gruntfile"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "javascript",
        "scopeName": "source.javascript",
        "path": "./syntaxes/javascript.tmLanguage.json"
      }
    ]
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}