{
  "name": "dardcor-swift",
  "displayName": "Swift",
  "description": "Swift language grammar for Dardcor Code",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "languages": [
      {
        "id": "swift",
        "aliases": [
          "Swift",
          "swift"
        ],
        "extensions": [
          "swift"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "swift",
        "scopeName": "source.swift",
        "path": "./syntaxes/swift.tmLanguage.json"
      }
    ]
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}