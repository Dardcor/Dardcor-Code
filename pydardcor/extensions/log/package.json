{
  "name": "dardcor-log",
  "displayName": "Log",
  "description": "Log language grammar for Dardcor Code",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "languages": [
      {
        "id": "log",
        "aliases": [
          "Log",
          "log"
        ],
        "extensions": [
          "log"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "log",
        "scopeName": "source.log",
        "path": "./syntaxes/log.tmLanguage.json"
      }
    ]
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}