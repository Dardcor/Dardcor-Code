{
  "name": "dardcor-github",
  "displayName": "GitHub",
  "description": "GitHub integration",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "commands": [
      {
        "command": "github.hello",
        "title": "GitHub: Show Info"
      }
    ],
    "configuration": {
      "title": "GitHub",
      "properties": {
        "github.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable GitHub"
        }
      }
    }
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}