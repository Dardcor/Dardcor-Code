{
  "name": "dardcor-vb",
  "displayName": "Visual Basic",
  "description": "Visual Basic language grammar for Dardcor Code",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "languages": [
      {
        "id": "vb",
        "aliases": [
          "Visual Basic",
          "vb"
        ],
        "extensions": [
          "vb",
          "vbs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vb",
        "scopeName": "source.vb",
        "path": "./syntaxes/vb.tmLanguage.json"
      }
    ]
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}