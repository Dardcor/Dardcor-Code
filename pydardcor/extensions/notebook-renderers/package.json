{
  "name": "dardcor-notebook-renderers",
  "displayName": "Notebook Renderers",
  "description": "Rich notebook output renderers",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "commands": [
      {
        "command": "notebook-renderers.hello",
        "title": "Notebook Renderers: Show Info"
      }
    ],
    "configuration": {
      "title": "Notebook Renderers",
      "properties": {
        "notebook-renderers.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Notebook Renderers"
        }
      }
    }
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}