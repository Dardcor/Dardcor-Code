{
  "name": "dardcor-coffeescript",
  "displayName": "CoffeeScript",
  "description": "CoffeeScript language grammar for Dardcor Code",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "languages": [
      {
        "id": "coffeescript",
        "aliases": [
          "CoffeeScript",
          "coffeescript"
        ],
        "extensions": [
          "coffee",
          "litcoffee"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "coffeescript",
        "scopeName": "source.coffeescript",
        "path": "./syntaxes/coffeescript.tmLanguage.json"
      }
    ]
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}