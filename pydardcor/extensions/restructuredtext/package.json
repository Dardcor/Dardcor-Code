{
  "name": "dardcor-restructuredtext",
  "displayName": "reStructuredText",
  "description": "reStructuredText language grammar for Dardcor Code",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "languages": [
      {
        "id": "restructuredtext",
        "aliases": [
          "reStructuredText",
          "restructuredtext"
        ],
        "extensions": [
          "rst"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "restructuredtext",
        "scopeName": "source.restructuredtext",
        "path": "./syntaxes/restructuredtext.tmLanguage.json"
      }
    ]
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}