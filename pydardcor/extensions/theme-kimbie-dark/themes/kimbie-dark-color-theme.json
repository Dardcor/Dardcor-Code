{
  "name": "kimbie-dark-color-theme",
  "type": "dark",
  "colors": {
    "editor.background": "#221a0f",
    "editor.foreground": "#d3af86",
    "editor.selectionBackground": "#493318",
    "editor.lineHighlightBackground": "#2a2014",
    "editorCursor.foreground": "#ff6600",
    "editorWhitespace.foreground": "#3a2a1a",
    "editorLineNumber.foreground": "#5a4a3a",
    "editorIndentGuide.background": "#332418"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6a9955"
      }
    }
  ]
}