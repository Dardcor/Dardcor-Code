{
  "name": "dardcor-mermaid-markdown-features",
  "displayName": "Mermaid Markdown",
  "description": "Mermaid diagram support in Markdown",
  "version": "1.68.0",
  "publisher": "dardcor",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "extension.py",
  "contributes": {
    "commands": [
      {
        "command": "mermaid-markdown-features.hello",
        "title": "Mermaid Markdown: Show Info"
      }
    ],
    "configuration": {
      "title": "Mermaid Markdown",
      "properties": {
        "mermaid-markdown-features.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Mermaid Markdown"
        }
      }
    }
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters",
    "Language Packs"
  ]
}