{
  "name": "Dardcor Code",
  "nameShort": "Dardcor Code",
  "nameLong": "Dardcor Code",
  "applicationName": "dardcor-code",
  "dataFolderName": ".dardcor-code",
  "version": "1.0.0",
  "commit": "dev",
  "date": "2026-07-08",
  "quality": "stable",
  "extensionsGallery": {
    "serviceUrl": "https://marketplace.visualstudio.com/_apis/public/gallery",
    "cacheUrl": "https://vscode.blob.core.windows.net/gallery/index",
    "itemUrl": "https://marketplace.visualstudio.com/items"
  },
  "builtInExtensions": [],
  "urlProtocol": "dardcor",
  "reportIssueUrl": "https://github.com/dardcor/dardcor-code/issues",
  "licenseUrl": "https://dardcor.com/privacy",
  "privacyStatementUrl": "https://dardcor.com/privacy",
  "documentationUrl": "https://dardcor.com/docs",
  "releaseNotesUrl": "https://dardcor.com/changelog",
  "keyboardShortcutsUrlLinux": "https://dardcor.com/shortcuts/linux",
  "keyboardShortcutsUrlMac": "https://dardcor.com/shortcuts/mac",
  "keyboardShortcutsUrlWin": "https://dardcor.com/shortcuts/win",
  "introductoryVideoUrl": "",
  "tipsAndTricksUrl": "https://dardcor.com/tips",
  "checksumUrl": "",
  "enableTelemetry": false,
  "aiConfig": {
    "asimovKey": "",
    "ariaKey": ""
  },
  "defaults": {
    "editor.fontSize": 14,
    "editor.fontFamily": "'Cascadia Code', 'Fira Code', Consolas, 'Courier New', monospace",
    "editor.tabSize": 4,
    "editor.wordWrap": "off",
    "editor.minimap.enabled": true,
    "editor.lineNumbers": "on",
    "editor.renderWhitespace": "selection",
    "editor.bracketPairColorization.enabled": true,
    "editor.autoClosingBrackets": "languageDefined",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.suggestOnTriggerCharacters": true,
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    },
    "editor.parameterHints.enabled": true,
    "editor.hover.enabled": true,
    "files.autoSave": "off",
    "files.autoSaveDelay": 1000,
    "files.encoding": "utf8",
    "files.eol": "auto",
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false,
    "workbench.colorTheme": "Default Dark+",
    "workbench.iconTheme": "vs-seti",
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.wrapTabs": false,
    "workbench.editor.enablePreview": true,
    "workbench.sideBar.location": "left",
    "workbench.statusBar.visible": true,
    "workbench.activityBar.location": "default",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.fontFamily": "Cascadia Code, Consolas, 'Courier New', monospace",
    "terminal.integrated.shell.windows": "powershell.exe",
    "terminal.integrated.scrollback": 1000,
    "extensions.autoUpdate": true,
    "extensions.autoCheckUpdates": true,
    "git.enabled": true,
    "git.autofetch": false,
    "git.confirmSync": true
  }
}

