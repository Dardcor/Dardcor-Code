# Dardcor Code environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
DATA_DIR=/var/lib/dardcor-code

# Optional local-only dashboard bootstrap. If unset and no saved password exists,
# open the dashboard through localhost and create one. On first successful local
# login, this value is bcrypt-hashed into the DB and the stored hash takes over.
# INITIAL_PASSWORD=

# Recommended runtime variables
PORT=21128
NODE_ENV=production

# Recommended security and ops variables
# API_KEY_SECRET: HMAC secret for generated API keys. Optional. If unset, a
# 32-byte random value is generated and persisted to $DATA_DIR/api-key-secret
# (mode 0600). A strong user-supplied value is still honored. Known weak values
# are rejected at startup.
# API_KEY_SECRET=
# MACHINE_ID_SALT: salt for stable machine ID hashing. Optional. If unset, a
# 32-byte random value is generated and persisted to $DATA_DIR/machine-id-salt
# (mode 0600). A strong user-supplied value is still honored. Known weak values
# are rejected at startup.
# MACHINE_ID_SALT=
# JWT_SECRET: JWT signing secret for the dashboard auth cookie. Optional. If
# unset, a 32-byte random value is generated and persisted to $DATA_DIR/jwt-secret
# (mode 0600). A strong user-supplied value is still honored. Known weak values
# are rejected at startup before the listener binds.
# JWT_SECRET=
ENABLE_REQUEST_LOGS=false
# MITM_CURSOR_CAPTURE: opt-in, local-only wire capture for the byte-transparent
# Cursor AgentService relay (src/mitm). Completely inactive unless set to 1.
# Default writes metadata only (timestamp, method, pathname with query stripped,
# byte counts, truncation flags, response status, error message, and response
# header/trailer NAMES). No request headers, auth tokens, cookies, checksums, or
# body text are ever written to metadata.
MITM_CURSOR_CAPTURE=0
# MITM_CURSOR_CAPTURE_FULL: explicit second consent. Raw protobuf request/response
# bytes are written to $DATA_DIR/logs/mitm/cursor-capture/ ONLY when this is also
# 1. Raw bytes may contain prompts, code context, tool data, and results — use a
# sanitized prompt, disable immediately, and delete captures after analysis.
# Directory mode 0700, file mode 0600, capped at 4 MiB request / 16 MiB response
# per stream.
MITM_CURSOR_CAPTURE_FULL=0
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
# REQUIRE_API_KEY: gate /v1 and /v1beta routes behind a valid API key. Default ON for
# fresh installs. Exact semantics:
#   true   -> force enforcement on, overriding the persisted setting
#   false  -> explicitly opt out, overriding the persisted setting
#   unset  -> use the persisted dashboard setting (fresh default is true)
# Any other value is ignored. When enforcement is active, every /v1 route
# (including /v1/models, /v1/models/[kind], /v1/models/info) requires a
# valid key from the dashboard API Keys page.
REQUIRE_API_KEY=true

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables. BASE_URL stays local — nothing reaches a
# remote host by default; the public domain is config, never a hardcoded default.
BASE_URL=http://localhost:21128
CLOUD_URL=https://dardcor-code.web.id
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:21128
NEXT_PUBLIC_CLOUD_URL=https://dardcor-code.web.id

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=dardcor-code
