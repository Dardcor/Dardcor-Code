{
  "schema": "dardcor-bench-matrix/1",
  "schemaVersion": 1,
  "documentedLimitations": {
    "realProviders": {
      "implemented": false,
      "note": "Network stays opt-in for the later runner. Phase 9 provides only the offline mock provider (bench/mockProvider.js); a real-provider mode must be added behind an explicit flag in the runner, never as the default."
    },
    "perFilterToggling": {
      "implemented": false,
      "note": "RTK filters are auto-detected per tool_result (open-sse/rtk/autodetect.js) and are not individually toggleable. The matrix toggles rtkEnabled as a whole; individual filters are exercised by fixture content (see expect.rtkFiltersLikelyHit on each fixture)."
    },
    "l0Toggle": {
      "implemented": false,
      "note": "L0 prompt-cache orchestration (open-sse/cache/l0.js) runs automatically for OpenAI-shaped bodies and has no user-facing toggle. 'L0-only' configs therefore mean L1/L2/L3 disabled while L0 remains active; the matrix models L0 via the mock provider's deterministic cache-read/cache-creation accounting."
    },
    "l2RequiresEmbeddings": {
      "implemented": false,
      "note": "L2 semantic cache embeds via the gateway's /v1/embeddings (src/lib/cache/semanticEmbed.js, semanticCacheModel setting). In offline runs the runner must either wire an embeddings backend or accept L2 failing closed to a miss (spec: an embedding failure is a miss, never an error)."
    }
  },
  "fixtures": [
    "tool-heavy-refactor",
    "large-file-read",
    "multi-turn-session",
    "cache-integrity"
  ],
  "dimensions": {
    "cacheLayers": {
      "L0": { "knob": "automatic (open-sse/cache/l0.js)", "note": "provider prompt-cache orchestration; always active for messages[] bodies; modeled by mock provider usage" },
      "L1": { "knob": "cacheL1Enabled", "note": "exact-response cache; default true; temperature=0 only" },
      "L2": { "knob": "cacheL2Enabled + semanticCacheThreshold + semanticCacheModel", "note": "semantic response cache; default false; needs embeddings backend" },
      "L3": { "knob": "cacheL3Enabled + cacheL3MinChars", "note": "content-address dedup; default false; default min chars 1000" }
    },
    "compressionModes": {
      "rtk": {
        "knob": "rtkEnabled",
        "note": "auto-detected tool-result filters",
        "filters": ["git-diff", "git-status", "git-log", "grep", "find", "ls", "tree", "dedup-log", "smart-truncate", "read-numbered", "search-list", "build-output"]
      },
      "caveman": { "knob": "cavemanEnabled + cavemanLevel", "levels": ["lite", "full", "ultra", "wenyan-lite", "wenyan", "wenyan-ultra"], "note": "system-prompt output saver; level default full" },
      "ponytail": { "knob": "ponytailEnabled + ponytailLevel", "levels": ["lite", "full", "ultra"], "note": "system-prompt output saver; level default full" },
      "headroom": { "knob": "headroomEnabled + headroomUrl", "requiresNetwork": true, "note": "external local /v1/compress proxy; excluded from offline runs" },
      "pxpipe": { "knob": "pxpipeEnabled", "requiresClaudeFormat": true, "note": "image-rendering compressor; Claude-format only; excluded from OpenAI-format runs" }
    },
    "routingStrategies": {
      "fallback": { "knob": "comboStrategy: \"fallback\"", "note": "sequential model attempts, fall through on error (default)" },
      "round-robin": { "knob": "comboStrategy: \"round-robin\"", "note": "rotates the starting model per request (getRotatedModels)" },
      "fusion": { "knob": "comboStrategy: \"fusion\"", "note": "parallel panel fan-out + judge synthesis (handleFusionChat)" }
    },
    "streaming": ["stream", "non-stream"]
  },
  "configs": [
    {
      "id": "all-off",
      "description": "Baseline: no cache layers, no compression, default fallback routing, non-streaming.",
      "stream": false,
      "settings": {
        "cacheL1Enabled": false,
        "cacheL2Enabled": false,
        "cacheL3Enabled": false,
        "rtkEnabled": false,
        "cavemanEnabled": false,
        "ponytailEnabled": false,
        "comboStrategy": "fallback"
      }
    },
    {
      "id": "all-on",
      "description": "Everything enabled: L1+L2+L3 caches, rtk+caveman+ponytail compression, round-robin routing, streaming.",
      "stream": true,
      "settings": {
        "cacheL1Enabled": true,
        "cacheL2Enabled": true,
        "cacheL3Enabled": true,
        "semanticCacheThreshold": 0.92,
        "cacheL3MinChars": 1000,
        "rtkEnabled": true,
        "cavemanEnabled": true,
        "cavemanLevel": "full",
        "ponytailEnabled": true,
        "ponytailLevel": "full",
        "comboStrategy": "round-robin"
      }
    },
    {
      "id": "l0-only",
      "description": "Only L0 provider-prompt-cache (automatic); L1/L2/L3 and compression off.",
